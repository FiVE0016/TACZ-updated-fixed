  ],
  "client": [
    "accessor.BlockableEventLoopAccessor",
    "accessor.ScreenAccessor",
    "client.AbstractPlayerMixin",
    "client.ClientLevelMixin",
    "client.CreateWorldScreenMixin",
    "client.GuiMixin",
    "client.KeyboardHandlerMixin",
    "client.LivingEntityRendererMixin",
    "client.MinecraftMixin",
    "client.MinecraftUseRestartMixin",
    "client.MouseHandlerMixin",
