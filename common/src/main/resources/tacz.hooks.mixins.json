  "mixins": [
    "common.AbstractMinecartMixin",
    "common.BundlePacketMixin",
    "common.EntityMixin",
    "common.LivingEntityHurtMixin",
    "common.LivingEntityMixin",
    "common.LootTableMixin",
    "common.PackRepositoryMixin",
    "common.PersistentEntitySectionManagerMixin",
    "common.PlayerListMixin",
    "common.PlayerMixin",
    "common.ServerLevelMixin",
    "common.ServerPacksSourceMixin",
    "common.itemhandler.AbstractHorseMixin",
