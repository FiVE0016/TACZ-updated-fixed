{
  "required": true,
  "minVersion": "0.8",
  "package": "me.xjqsh.lrtactical.mixin",
  "compatibilityLevel": "JAVA_21",
  "mixinextras": {
    "minVersion": "0.5.0"
  },
  "_comment": "LRTactical (unofficial 26.3 port) mixins. Kept separate from the tacz.*.mixins.json configs because those are bound to TACZ's own mixin packages.",
  "mixins": [
    "accessor.PlayerInvoker"
  ],
  "client": [
    "accessor.ConditionalItemModelPropertiesAccessor",
    "client.GuiGraphicsExtractorMixin",
    "client.SoundInstanceVolumeMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  }
}
